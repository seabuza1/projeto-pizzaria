# Agente de impressão: copie para .env ao lado deste arquivo (fora do repositório) e preencha.
# Só a anon key; a service role nunca. A conta é a de papel `agente`.
MEL_SUPABASE_URL=
MEL_SUPABASE_ANON_KEY=
MEL_AGENTE_EMAIL=
MEL_AGENTE_SENHA=
# Térmica de 80 mm no Wi-Fi da loja, com IP fixo (reserva no roteador).
MEL_IMPRESSORA_HOST=
MEL_IMPRESSORA_PORTA=9100
MEL_IMPRESSORA_NOME=balcao
# Impressão sem internet, só em localhost.
MEL_AGENTE_PORTA_LOCAL=9180
